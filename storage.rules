rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de propiedades — lectura pública (se muestran en el portal);
    // escritura autenticada, sin sobrescritura ni borrado por terceros.
    match /properties/{allPaths=**} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Fotos de marketplace — lectura pública, escritura autenticada
    match /marketplace/{allPaths=**} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Comprobantes de pago de servicios (owner-services, invoices-view):
    // particionados por adminId. Lectura autenticada (el que sube necesita
    // getDownloadURL); crear autenticado; modificar/borrar solo el admin dueño
    // de la partición — un usuario de otra organización no puede pisar ni
    // borrar archivos ajenos.
    match /comprobantes/{adminId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == adminId;
    }

    // Recibos informados por inquilinos (tenant-invoices) — mismo esquema
    match /recibos/{adminId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == adminId;
    }

    // Fotos de tickets de mantenimiento (tenant-maintenance) — mismo esquema
    match /mantenimiento/{adminId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == adminId;
    }

    // Todo lo demás: denegado. Antes había un catch-all autenticado que
    // permitía a cualquier usuario logueado leer y sobrescribir cualquier
    // archivo de cualquier organización. Los prefijos en uso están todos
    // declarados arriba; si se agrega un path nuevo en el código, hay que
    // darle su regla acá.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
