rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.uid == 'wYkBqQjJuSdQu7F20eFAHZ0qX9N2';
    }

    function emailMatches(field) {
      return isSignedIn() && resource.data[field] == request.auth.token.email;
    }

    function newEmailMatches(field) {
      return isSignedIn() && request.resource.data[field] == request.auth.token.email;
    }

    function isAdminOf(field) {
      return isSignedIn() && resource.data[field] == request.auth.uid;
    }

    function newIsAdminOf(field) {
      return isSignedIn() && request.resource.data[field] == request.auth.uid;
    }

    // ── Datos globales de plataforma (superadmin) ──────────────────────────────

    match /artifacts/{appId}/superadmin/data/organizations/{orgId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /artifacts/{appId}/superadmin/data/org_users/{docId} {
      allow read: if isSuperAdmin() || emailMatches('email');
      allow write: if isSuperAdmin();
    }

    match /artifacts/{appId}/superadmin/{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // ── Comunidad & Marketplace ─────────────────────────────────────────────

    match /artifacts/{appId}/comunidadPosts/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && newIsAdminOf('authorId');
      allow update, delete: if isAdminOf('authorId') || isSuperAdmin();
    }

    match /artifacts/{appId}/comunidadMarketplace/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && newIsAdminOf('sellerId');
      allow update, delete: if isAdminOf('sellerId') || isSuperAdmin();
    }

    match /artifacts/{appId}/comunidadEventos/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && newIsAdminOf('creatorId');
      allow update, delete: if isAdminOf('creatorId') || isSuperAdmin();
    }

    match /artifacts/{appId}/comunidadBeneficios/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && newIsAdminOf('adminId');
      allow update, delete: if isAdminOf('adminId') || isSuperAdmin();
    }

    match /artifacts/{appId}/comunidadTransacciones/{docId} {
      allow read: if isAdminOf('buyerId') || isAdminOf('sellerId') || isSuperAdmin();
      allow create: if isSignedIn() && newIsAdminOf('buyerId');
      allow update, delete: if isSuperAdmin();
    }

    // ── Portal Inquilino & Propietario ──────────────────────────────────────

    // tenantRegistry: el admin que lo creó tiene write; el inquilino lee el suyo
    match /artifacts/{appId}/tenantRegistry/{docId} {
      allow get: if isAdminOf('adminId') || emailMatches('tenantEmail') || isSuperAdmin();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && newIsAdminOf('adminId');
      allow update, delete: if isAdminOf('adminId') || isSuperAdmin();
    }

    // ownerRegistry: idem
    match /artifacts/{appId}/ownerRegistry/{docId} {
      allow get: if isAdminOf('adminId') || emailMatches('ownerEmail') || isSuperAdmin();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && newIsAdminOf('adminId');
      allow update, delete: if isAdminOf('adminId') || isSuperAdmin();
    }

    // Chats compartidos admin↔inquilino↔propietario
    match /artifacts/{appId}/sharedChats/{chatId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        request.auth.uid == resource.data.ownerId ||
        request.auth.token.email == resource.data.tenantEmail ||
        request.auth.token.email == resource.data.ownerEmail ||
        isSuperAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.adminId == request.auth.uid ||
        request.resource.data.tenantEmail == request.auth.token.email ||
        request.resource.data.ownerEmail == request.auth.token.email ||
        isSuperAdmin()
      );
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        request.auth.uid == resource.data.ownerId ||
        request.auth.token.email == resource.data.tenantEmail ||
        request.auth.token.email == resource.data.ownerEmail
      );
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        request.auth.uid == resource.data.ownerId ||
        isSuperAdmin()
      );
    }

    match /artifacts/{appId}/sharedChats/{chatId}/mensajes/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
    }

    // Pago anticipado: admin (adminId) e inquilino (tenantEmail)
    match /artifacts/{appId}/advancePaymentRequests/{reqId} {
      allow get: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        request.auth.token.email == resource.data.tenantEmail ||
        isSuperAdmin()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.tenantEmail == request.auth.token.email ||
        request.resource.data.adminId == request.auth.uid ||
        isSuperAdmin()
      );
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        request.auth.token.email == resource.data.tenantEmail ||
        isSuperAdmin()
      );
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.adminId || isSuperAdmin()
      );
    }

    match /artifacts/{appId}/maintenanceTickets/{ticketId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        request.auth.token.email == resource.data.tenantEmail ||
        (resource.data.ownerVisible == true && request.auth.token.email == resource.data.ownerEmail) ||
        isSuperAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.adminId == request.auth.uid ||
        request.resource.data.tenantEmail == request.auth.token.email ||
        isSuperAdmin()
      );
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        request.auth.token.email == resource.data.tenantEmail ||
        isSuperAdmin()
      );
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.adminId || isSuperAdmin()
      );
    }

    // Notarizaciones públicas: cualquiera puede leer (verificación pública en blockchain)
    match /artifacts/{appId}/notarizations/{txHash} {
      allow read: if true;
      allow write: if false; // solo backend con admin SDK
    }

    // ── Colecciones por usuario admin ──────────────────────────────────────

    // Documento de usuario: guarda currentSessionId para el cierre de sesión
    // cross-device. Solo el backend (Admin SDK) escribe; el dueño lo lee para
    // detectar si otro dispositivo tomó la sesión.
    match /artifacts/{appId}/users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow write: if false;
    }

    // Contratos: admin full access; inquilino lee el suyo
    match /artifacts/{appId}/users/{userId}/contratos/{contractId} {
      allow read: if isOwner(userId) ||
        (isSignedIn() && resource.data.tenantEmail == request.auth.token.email) ||
        isSuperAdmin();
      allow write: if isOwner(userId);
    }

    // Propiedades: admin full access; signed-in para lectura individual (postulantes/marketplace)
    match /artifacts/{appId}/users/{userId}/propiedades/{propiedadId} {
      allow get: if isSignedIn();
      allow list: if isOwner(userId) || isSuperAdmin();
      allow create, update, delete: if isOwner(userId);
    }

    // Solicitudes: cualquiera crea (formulario público); solo admin lee/edita
    match /artifacts/{appId}/users/{userId}/solicitudes/{solicitudId} {
      allow create: if true;
      allow get, list, update, delete: if isOwner(userId) || isSuperAdmin();
    }

    // Facturas: admin full; inquilino lee las suyas; propietario lee las de su propiedad
    match /artifacts/{appId}/users/{userId}/facturas/{invoiceId} {
      allow read: if isOwner(userId) ||
        (isSignedIn() && resource.data.tenantEmail == request.auth.token.email) ||
        (isSignedIn() && resource.data.ownerEmail  == request.auth.token.email) ||
        isSuperAdmin();
      allow write: if isOwner(userId);
    }

    // Mantenimiento: admin full; propietario lee/aprueba las suyas
    match /artifacts/{appId}/users/{userId}/mantenimiento/{taskId} {
      allow read: if isOwner(userId) ||
        (isSignedIn() && resource.data.ownerEmail == request.auth.token.email) ||
        isSuperAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) ||
        (isSignedIn() && resource.data.ownerEmail == request.auth.token.email);
      allow delete: if isOwner(userId);
    }

    // Legales: admin full; inquilino lee planes de pago propios
    match /artifacts/{appId}/users/{userId}/legales/{caseId} {
      allow read: if isOwner(userId) ||
        (isSignedIn() && resource.data.tenantEmail == request.auth.token.email) ||
        isSuperAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) ||
        (isSignedIn() && resource.data.tenantEmail == request.auth.token.email);
      allow delete: if isOwner(userId);
    }

    // Liquidaciones: propietario lee las suyas
    match /artifacts/{appId}/users/{userId}/liquidaciones/{liqId} {
      allow read: if isOwner(userId) ||
        (isSignedIn() && resource.data.ownerEmail == request.auth.token.email) ||
        isSuperAdmin();
      allow write: if isOwner(userId);
    }

    // ── Seguros & PAS ──────────────────────────────────────────────────────

    match /artifacts/{appId}/seguroComisiones/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && newIsAdminOf('adminId');
      allow update: if isAdminOf('adminId') || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /artifacts/{appId}/pasPartners/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /artifacts/{appId}/pasComisiones/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ── Comodín por usuario: cualquier subcolección no listada arriba ──────

    match /artifacts/{appId}/users/{userId}/{collection}/{docId} {
      allow read, write: if isOwner(userId) || isSuperAdmin();
    }
  }
}
