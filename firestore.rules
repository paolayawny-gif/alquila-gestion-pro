rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // SuperAdmin: custom claim (preferido) con fallback a SUPERADMIN_UID durante migración.
    // Para eliminar el UID del código: llamar a /api/superadmin/set-custom-claims una vez
    // como superadmin, luego remover la segunda condición en el próximo deploy.
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.superAdmin == true ||
        request.auth.uid == 'wYkBqQjJuSdQu7F20eFAHZ0qX9N2'
      );
    }

    function emailIs(value) {
      return isSignedIn() && request.auth.token.email == value;
    }

    // ── Datos globales de plataforma (superadmin) ──────────────────────────────

    // Organizaciones: superadmin escribe; cualquier autenticado puede leer (para detectar su org al loguearse)
    match /artifacts/{appId}/superadmin/data/organizations/{orgId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Usuarios de org: superadmin escribe; un usuario puede leer su propio registro por email
    match /artifacts/{appId}/superadmin/data/org_users/{docId} {
      allow read: if isSuperAdmin() || emailIs(resource.data.email);
      allow write: if isSuperAdmin();
    }

    // Comodín superadmin — cubre cualquier colección futura
    match /artifacts/{appId}/superadmin/{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // ── Documento de usuario ───────────────────────────────────────────────────

    // Guarda currentSessionId para el cierre de sesión cross-device.
    // Solo el backend (Admin SDK) escribe; el dueño lo lee para detectar si
    // otro dispositivo tomó la sesión.
    match /artifacts/{appId}/users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow write: if false;
    }

    // ── Comunidad & Marketplace — compartido entre todos los usuarios ─────────

    // Muro: cualquier autenticado lee; se crea SOLO a nombre propio; solo el autor (o superAdmin) edita/borra
    match /artifacts/{appId}/comunidadPosts/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.authorId || isSuperAdmin());
    }

    // Marketplace: se crea SOLO a nombre propio; solo el vendedor (o superAdmin) edita/borra
    match /artifacts/{appId}/comunidadMarketplace/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.sellerId || isSuperAdmin());
    }

    // Eventos & Roomies: se crean SOLO a nombre propio; solo el creador (o superAdmin) edita/borra
    match /artifacts/{appId}/comunidadEventos/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.creatorId || isSuperAdmin());
    }

    // Beneficios: cualquier autenticado lee; solo el autor edita/borra los suyos
    match /artifacts/{appId}/comunidadBeneficios/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isSuperAdmin());
    }

    // Transacciones de comisión: cualquier autenticado lee; solo superadmin edita/borra.
    // Create requiere que los IDs de comprador y vendedor coincidan con el caller.
    match /artifacts/{appId}/comunidadTransacciones/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.sellerId == request.auth.uid ||
        request.resource.data.buyerId == request.auth.uid
      );
      allow update, delete: if isSuperAdmin();
    }

    // ── Portal Inquilino & Propietario ──────────────────────────────────────

    // Registro de inquilinos: SOLO el admin que lo creó escribe; el inquilino lee el suyo.
    // FIX: get restringido a adminId del documento o al inquilino cuyo email coincide.
    match /artifacts/{appId}/tenantRegistry/{docId} {
      allow get: if isSuperAdmin()
              || (isSignedIn() && request.auth.uid == resource.data.adminId)
              || (isSignedIn() && request.auth.token.email == resource.data.tenantEmail);
      allow list: if isSuperAdmin();
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.adminId == request.auth.uid || isSuperAdmin());
      allow delete: if isSignedIn() && (resource.data.adminId == request.auth.uid || isSuperAdmin());
    }

    // Registro de propietarios: el admin escribe; el propietario puede actualizar SU entrada.
    // FIX: get restringido a adminId o al propietario cuyo email coincide.
    match /artifacts/{appId}/ownerRegistry/{docId} {
      allow get: if isSuperAdmin()
              || (isSignedIn() && request.auth.uid == resource.data.adminId)
              || (isSignedIn() && request.auth.token.email == resource.data.ownerEmail);
      allow list: if isSuperAdmin();
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.adminId == request.auth.uid ||
        emailIs(resource.data.ownerEmail) ||
        isSuperAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.adminId == request.auth.uid || isSuperAdmin());
    }

    // Chats compartidos admin↔inquilino↔propietario
    match /artifacts/{appId}/sharedChats/{chatId} {
      // get individual: verificamos participación con resource.data
      allow get: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        request.auth.uid == resource.data.ownerId ||
        request.auth.token.email == resource.data.tenantEmail ||
        request.auth.token.email == resource.data.ownerEmail ||
        isSuperAdmin()
      );
      // FIX: list ahora requiere resource.data — Firestore obliga al cliente a incluir
      // where('adminId','==',uid) o where('tenantEmail','==',email) en la query;
      // sin el where correcto, Firestore rechaza la query.
      allow list: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        request.auth.uid == resource.data.ownerId ||
        request.auth.token.email == resource.data.tenantEmail ||
        request.auth.token.email == resource.data.ownerEmail ||
        isSuperAdmin()
      );
      // Solo se puede crear un chat del que uno mismo es participante
      allow create: if isSignedIn() && (
        request.resource.data.adminId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid ||
        request.resource.data.tenantEmail == request.auth.token.email ||
        request.resource.data.ownerEmail == request.auth.token.email ||
        isSuperAdmin()
      );
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        request.auth.uid == resource.data.ownerId ||
        request.auth.token.email == resource.data.tenantEmail ||
        request.auth.token.email == resource.data.ownerEmail
      );
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        request.auth.uid == resource.data.ownerId ||
        isSuperAdmin()
      );
    }

    // Mensajes: solo participantes del chat padre pueden leer/escribir
    match /artifacts/{appId}/sharedChats/{chatId}/mensajes/{msgId} {
      function chat() {
        return get(/databases/$(database)/documents/artifacts/$(appId)/sharedChats/$(chatId)).data;
      }
      allow read: if isSignedIn() && (
        request.auth.uid == chat().adminId ||
        request.auth.uid == chat().ownerId ||
        request.auth.token.email == chat().tenantEmail ||
        request.auth.token.email == chat().ownerEmail ||
        isSuperAdmin()
      );
      allow create: if isSignedIn() && (
        request.auth.uid == chat().adminId ||
        request.auth.uid == chat().ownerId ||
        request.auth.token.email == chat().tenantEmail ||
        request.auth.token.email == chat().ownerEmail ||
        isSuperAdmin()
      );
      allow update, delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
    }

    // Solicitudes de pago anticipado
    match /artifacts/{appId}/advancePaymentRequests/{reqId} {
      allow get: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        request.auth.token.email == resource.data.tenantEmail ||
        isSuperAdmin()
      );
      // FIX: list requiere resource.data — fuerza where('adminId','==',uid) o where('tenantEmail','==',email)
      allow list: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        request.auth.token.email == resource.data.tenantEmail ||
        isSuperAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.tenantEmail == request.auth.token.email ||
        request.resource.data.adminId == request.auth.uid ||
        isSuperAdmin()
      );
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        request.auth.token.email == resource.data.tenantEmail ||
        isSuperAdmin()
      );
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.adminId || isSuperAdmin()
      );
    }

    // Tickets de mantenimiento compartidos admin↔inquilino↔propietario
    match /artifacts/{appId}/maintenanceTickets/{ticketId} {
      allow get: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        request.auth.token.email == resource.data.tenantEmail ||
        (resource.data.ownerVisible == true && request.auth.token.email == resource.data.ownerEmail) ||
        isSuperAdmin()
      );
      // FIX: list requiere resource.data — fuerza where correcto en la query del cliente
      allow list: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        request.auth.token.email == resource.data.tenantEmail ||
        isSuperAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.adminId == request.auth.uid ||
        request.resource.data.tenantEmail == request.auth.token.email ||
        isSuperAdmin()
      );
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.adminId ||
        request.auth.token.email == resource.data.tenantEmail ||
        isSuperAdmin()
      );
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.adminId || isSuperAdmin()
      );
    }

    // Notarizaciones públicas: verificación pública en blockchain
    match /artifacts/{appId}/notarizations/{txHash} {
      allow read: if true;
      allow write: if false; // solo backend con Admin SDK
    }

    // Rate limits internos — solo el backend escribe (Admin SDK bypassa estas reglas)
    match /artifacts/{appId}/_rateLimits/{docId} {
      allow read, write: if false;
    }

    // ── Colecciones por usuario admin ──────────────────────────────────────────

    // Contratos: admin full access; inquilino puede leer el suyo
    match /artifacts/{appId}/users/{userId}/contratos/{contractId} {
      allow read: if isOwner(userId) ||
        (isSignedIn() && resource.data.tenantEmail == request.auth.token.email) ||
        isSuperAdmin();
      allow write: if isOwner(userId);
    }

    // Propiedades: lectura individual pública (postulantes/marketplace); escritura solo del admin dueño.
    // NOTA: get:true expone los datos del documento al público. Los campos de contacto del
    // propietario (ownerEmail, ownerName) deben ser separados a una subcolección privada en
    // un refactor futuro. Por ahora el portal público los necesita para el flujo de contacto.
    match /artifacts/{appId}/users/{userId}/propiedades/{propiedadId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create, update, delete: if isOwner(userId);
    }

    // Solicitudes: formulario público de postulación.
    // FIX: validación de campos mínimos para rechazar spam/datos basura sin auth.
    // El docId lo elige el cliente (UUID/random) — no se valida aquí.
    match /artifacts/{appId}/users/{userId}/solicitudes/{solicitudId} {
      allow create: if (
        request.resource.data.keys().hasAll(['applicantName', 'applicantEmail', 'status', 'propertyId'])
        && request.resource.data.applicantName is string
        && request.resource.data.applicantName.size() > 0
        && request.resource.data.applicantName.size() <= 200
        && request.resource.data.applicantEmail is string
        && request.resource.data.applicantEmail.size() > 3
        && request.resource.data.applicantEmail.size() <= 254
        && request.resource.data.status == 'Nueva'
      );
      allow get, list, update, delete: if isOwner(userId) || isSuperAdmin();
    }

    // Facturas: admin full access; inquilino lee las suyas y puede informar el pago;
    // propietario lee las de su propiedad
    match /artifacts/{appId}/users/{userId}/facturas/{invoiceId} {
      allow read: if isOwner(userId) ||
        (isSignedIn() && resource.data.tenantEmail == request.auth.token.email) ||
        (isSignedIn() && resource.data.ownerEmail  == request.auth.token.email) ||
        isSuperAdmin();
      allow create, delete: if isOwner(userId);
      // El inquilino solo puede tocar los campos de "pago informado"
      allow update: if isOwner(userId) || (
        isSignedIn() &&
        resource.data.tenantEmail == request.auth.token.email &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'tenantReceiptUrl', 'tenantReceiptNote'])
      );
    }

    // Mantenimiento: admin full access; propietario lee y aprueba/rechaza las suyas
    match /artifacts/{appId}/users/{userId}/mantenimiento/{taskId} {
      allow read: if isOwner(userId) ||
        (isSignedIn() && resource.data.ownerEmail == request.auth.token.email) ||
        isSuperAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) ||
        (isSignedIn() && resource.data.ownerEmail == request.auth.token.email);
      allow delete: if isOwner(userId);
    }

    // Legales: admin full access; inquilino ve/actualiza sus planes de pago
    match /artifacts/{appId}/users/{userId}/legales/{caseId} {
      allow read: if isOwner(userId) ||
        (isSignedIn() && resource.data.tenantEmail == request.auth.token.email) ||
        isSuperAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) ||
        (isSignedIn() && resource.data.tenantEmail == request.auth.token.email);
      allow delete: if isOwner(userId);
    }

    // Liquidaciones: admin full access; propietario lee las suyas
    match /artifacts/{appId}/users/{userId}/liquidaciones/{liqId} {
      allow read: if isOwner(userId) ||
        (isSignedIn() && resource.data.ownerEmail == request.auth.token.email) ||
        isSuperAdmin();
      allow write: if isOwner(userId);
    }

    // Ofertas de monetización: admin full access; cualquier autenticado puede leerlas
    match /artifacts/{appId}/users/{userId}/monetizationOffers/{offerId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Pedidos de monetización: admin full access; el inquilino puede crear el suyo
    match /artifacts/{appId}/users/{userId}/monetizationRequests/{requestId} {
      allow read: if isOwner(userId) ||
        (isSignedIn() && resource.data.tenantEmail == request.auth.token.email) ||
        isSuperAdmin();
      allow create: if isOwner(userId) ||
        (isSignedIn() && request.resource.data.tenantEmail == request.auth.token.email);
      allow update, delete: if isOwner(userId);
    }

    // ── Anuncios de plataforma (novedades del superadmin) ─────────────────────

    // Cualquier usuario autenticado puede leer; solo el superadmin escribe
    match /artifacts/{appId}/anuncios/{anuncioId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ── Seguros & PAS ──────────────────────────────────────────────────────────

    match /artifacts/{appId}/seguroComisiones/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /artifacts/{appId}/pasPartners/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /artifacts/{appId}/pasComisiones/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Eventos de propiedad: timeline inmutable — admin crea; nadie edita/borra
    match /artifacts/{appId}/users/{userId}/propertyEvents/{eventId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create: if isOwner(userId);
      allow update, delete: if false; // eventos son inmutables
    }

    // ── Comodín por usuario: cualquier OTRA subcolección bajo users/{uid} ──────
    // FIX: solo read — write eliminado para evitar que este comodín anule reglas
    // de inmutabilidad de colecciones específicas (como propertyEvents).
    // Todas las subcolecciones con acceso write tienen sus propias reglas arriba.
    match /artifacts/{appId}/users/{userId}/{collection}/{docId} {
      allow read: if isOwner(userId) || isSuperAdmin();
    }
  }
}
